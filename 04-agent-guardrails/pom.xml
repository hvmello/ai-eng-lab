<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.hvmello.aienglab</groupId>
    <artifactId>ai-eng-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>04-agent-guardrails</artifactId>
  <name>04-agent-guardrails</name>

  <dependencies>
    <dependency>
      <groupId>io.github.hvmello.aienglab</groupId>
      <artifactId>shared</artifactId>
    </dependency>
    <dependency>
      <!-- Reuses Tool, ToolResult, Arguments and friends. Nothing here uses Spring, so it is excluded. -->
      <groupId>io.github.hvmello.aienglab</groupId>
      <artifactId>02-tool-calling</artifactId>
      <version>${project.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.ai</groupId>
          <artifactId>spring-ai-ollama</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.github.hvmello.aienglab.agentguardrails.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
