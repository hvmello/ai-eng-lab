# Local models, used by default. No key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# Optional. Leave empty to stay on local models.
ANTHROPIC_API_KEY=

# Module 03-mcp-server
MCP_BASE_URL=
MCP_USER=
# bcrypt hash of the password (starts with $2a$, $2b$ or $2y$)
MCP_USER_PASSWORD_HASH=
# At least 32 random characters
MCP_CURSOR_KEY=
MCP_DB_URL=
MCP_DB_USER=
MCP_DB_PASSWORD=
